{
  "version": 2,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/online-classes",
      "dest": "/frontend/online-classes.html"
    },
    {
      "src": "/online-classes/",
      "dest": "/frontend/online-classes.html"
    },
    {
      "src": "/online-classes.html",
      "dest": "/frontend/online-classes.html"
    },
    {
      "src": "/request",
      "dest": "/frontend/request.html"
    },
    {
      "src": "/request/",
      "dest": "/frontend/request.html"
    },
    {
      "src": "/request/books",
      "dest": "/frontend/request.html"
    },
    {
      "src": "/request/books/",
      "dest": "/frontend/request.html"
    },
    {
      "src": "/request/devotional",
      "dest": "/frontend/request.html"
    },
    {
      "src": "/request/devotional/",
      "dest": "/frontend/request.html"
    },
    {
      "src": "/request/devotional/(.*)",
      "dest": "/frontend/request.html"
    },
    {
      "src": "/request.html",
      "dest": "/frontend/request.html"
    },
    {
      "src": "/sales",
      "dest": "/frontend/sales-kakinada.html"
    },
    {
      "src": "/sales/",
      "dest": "/frontend/sales-kakinada.html"
    },
    {
      "src": "/sales/kakinada",
      "dest": "/frontend/sales-kakinada.html"
    },
    {
      "src": "/sales/kakinada/",
      "dest": "/frontend/sales-kakinada.html"
    },
    {
      "src": "/sales-kakinada.html",
      "dest": "/frontend/sales-kakinada.html"
    },
    {
      "src": "/sales-kakinada.webmanifest",
      "dest": "/frontend/sales-kakinada.webmanifest"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/frontend/manifest.webmanifest"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|webp|svg|ico))",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
